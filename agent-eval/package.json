{
	"name": "agent-eval",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./lib/*.ts",
		"#test-utils": "./lib/test-utils.ts"
	},
	"scripts": {
		"eval": "agent-eval",
		"eval:dry": "agent-eval --dry",
		"gen:agentic-ref": "node scripts/generate-agentic-ref-experiments.ts",
		"eval:agentic-ref": "node scripts/run-agentic-ref.ts",
		"eval:agentic-ref:dry": "node scripts/run-agentic-ref.ts --dry",
		"eval:plan": "node scripts/run-plan.ts",
		"eval:plan:dry": "node scripts/run-plan.ts --dry",
		"playground": "agent-eval-playground --results-dir ./results --evals-dir ./evals",
		"playground:build": "next build --webpack",
		"playground:check-routes": "node ./scripts/check-playground-routes.mjs",
		"postinstall": "node ./scripts/setup-compare-stats.ts",
		"results:download": "node ./scripts/download-ci-results.mjs",
		"results:list": "node ./scripts/list-results.ts",
		"results:prune": "node ./scripts/prune-incomplete-runs.ts",
		"results:analyze": "pnpm gen:agentic-ref && node ./scripts/analyze-results.ts",
		"results:compare": "pnpm gen:agentic-ref && node ./scripts/compare-results.ts",
		"judge:ds-misuse": "node --env-file-if-exists=.env.local ./scripts/judge-ds-misuse.ts",
		"judge:ds-misuse:dry": "node --env-file-if-exists=.env.local ./scripts/judge-ds-misuse.ts --dry",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"vercel": "^54.18.5"
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "^0.117.1",
		"@tailwindcss/postcss": "^4.3.2",
		"@types/node": "catalog:trials",
		"@types/picomatch": "^4.0.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/yargs": "^17.0.35",
		"@vercel/agent-eval": "1.2.0",
		"@vercel/agent-eval-playground": "0.1.3",
		"@vitejs/plugin-react-swc": "catalog:trials",
		"@vitest/coverage-v8": "4.0.6",
		"diff": "^8.0.4",
		"memfs": "^4.68.0",
		"next": "16.1.6",
		"picomatch": "^4.0.5",
		"postcss": "^8.5.16",
		"tailwindcss": "^4.3.2",
		"typescript": "catalog:trials",
		"vitest": "catalog:",
		"yargs": "^17.7.3"
	},
	"pnpm": {
		"overrides": {
			"@ai-sdk/anthropic": "^2.0.0"
		},
		"patchedDependencies": {
			"@vercel/agent-eval@1.2.0": "patches/@vercel__agent-eval@1.2.0.patch"
		}
	}
}
