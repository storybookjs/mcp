{
	"name": "agent-eval",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./lib/*.ts",
		"#test-utils": "./lib/test-utils.ts"
	},
	"scripts": {
		"eval": "agent-eval",
		"eval:dry": "agent-eval --dry",
		"gen:agentic-ref": "node scripts/generate-agentic-ref-experiments.mts",
		"eval:agentic-ref": "pnpm gen:agentic-ref && cd .agentic-ref && EVAL_AGENTIC_REFERENCE=1 agent-eval run-all",
		"eval:agentic-ref:dry": "pnpm gen:agentic-ref && cd .agentic-ref && EVAL_AGENTIC_REFERENCE=1 agent-eval run-all --dry",
		"playground": "agent-eval playground",
		"playground:build": "next build --webpack",
		"playground:check-routes": "node ./scripts/check-playground-routes.mjs",
		"results:download": "node ./scripts/download-ci-results.mjs",
		"results:analyze": "node ./scripts/analyze-results.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"vercel": "^54.18.5"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.2",
		"@types/node": "catalog:trials",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vercel/agent-eval": "1.2.0",
		"@vercel/agent-eval-playground": "0.1.3",
		"@vitejs/plugin-react-swc": "catalog:trials",
		"diff": "^8.0.4",
		"next": "16.1.6",
		"postcss": "^8.5.16",
		"tailwindcss": "^4.3.2",
		"typescript": "catalog:trials",
		"vitest": "catalog:"
	},
	"pnpm": {
		"overrides": {
			"@ai-sdk/anthropic": "^2.0.0"
		},
		"patchedDependencies": {
			"@vercel/agent-eval@1.2.0": "patches/@vercel__agent-eval@1.2.0.patch"
		}
	}
}
